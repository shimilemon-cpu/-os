rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in ['shimilemon@gmail.com'];
    }

    function isRoomMember(roomId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    // ユーザープロフィール
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 招待コードルックアップ（誰でも読める・認証済みのみ作成）
    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ルーム
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() &&
        (isRoomMember(roomId)
         || (resource.data.status == "waiting"
             && request.auth.uid in request.resource.data.memberIds
             && request.resource.data.memberIds.hasAll(resource.data.memberIds)));
      allow delete: if isSignedIn() &&
        resource.data.hostId == request.auth.uid;

      // ルームメンバー
      match /members/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // グループ統計（累積学習データ）
      match /stats/{doc} {
        allow read: if isSignedIn();
        allow write: if isRoomMember(roomId);
      }

      // 殿堂入り
      match /hallOfFame/{answerId} {
        allow read: if isSignedIn();
        allow write: if isRoomMember(roomId);
      }
    }

    // ゲームセッション
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      // ラウンド（お題 + 進行ステータス）
      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();

        // 回答
        match /answers/{answerId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
          allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        }

        // 投票
        match /votes/{voteId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.voterId == request.auth.uid;
          allow delete: if isSignedIn() && (resource.data.voterId == request.auth.uid || isAdmin());
        }

        // AI講評
        match /aiReviews/{reviewId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }
  }
}
